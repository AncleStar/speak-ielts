{$APP_DOMAIN:localhost} {
  encode zstd gzip
  request_body {
    max_size 26MiB
  }
  reverse_proxy web:3000
  header {
    defer
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "microphone=(self), camera=(), geolocation=()"
  }
}
