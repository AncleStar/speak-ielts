{
  "name": "interview-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "setup:voice": "tsx scripts/setup-voice.ts",
    "check:providers": "tsx scripts/check-providers.ts",
    "check:practice": "tsx scripts/check-practice.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:pilot-content": "tsx scripts/audit-pilot-content.ts",
    "evaluate:asr": "tsx scripts/evaluate-asr.ts",
    "replay-deletions": "tsx scripts/replay-deletions.ts",
    "backup": "tsx scripts/backup.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "dev:all": "tsx scripts/dev-all.ts",
    "check:release": "tsx scripts/release-source.ts",
    "export:source": "tsx scripts/release-source.ts --export"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ali-oss": "6.23.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "kokoro-js": "1.2.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "three": "0.183.2",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/ali-oss": "6.23.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.183.1",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "license": "MIT"
}
