# ============================================================
# 线上模拟面试 App（雅思口语）环境变量示例
# 复制为 .env 后按需修改。不要把真实密钥提交到仓库。
# ============================================================

# ---- 数据库 ----
# 本机（npm run db:local 启动的内置 PostgreSQL）：
DATABASE_URL=postgres://postgres:postgres@localhost:5433/interview
# Docker Compose 内部使用：postgres://interview:<密码>@db:5432/interview
POSTGRES_PASSWORD=change-me-db-password

# ---- 账号认证 ----
# 至少 32 位随机字符串，可用：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 个人 API Key 加密使用的独立随机密钥（至少 32 字符）。留空时从认证密钥派生。
# 所有 web / worker 实例须一致；更换后已保存的个人 Key 需重新填写。
USER_API_KEY_SECRET=
# 首个管理员（仅首次启动 / 种子时创建；首次登录后必须修改密码）
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

# ---- AI 服务 ----
# mock = 模拟服务模式（无需密钥，界面会显示"模拟数据"标识）；dashscope = 阿里云百炼
AI_PROVIDER=mock
# 考官语音独立配置：kokoro 本机自然语音；auto 随 AI_PROVIDER；dashscope 云语音；mock 传统系统语音
# kokoro 首次运行前执行 npm run setup:voice（下载约 93 MB 模型）
TTS_PROVIDER=kokoro
LOCAL_TTS_VOICE=bf_emma
LOCAL_TTS_SPEED=0.95
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 语音合成使用百炼原生接口；留空时由 DASHSCOPE_BASE_URL 推导
DASHSCOPE_NATIVE_BASE_URL=
ASR_MODEL=qwen3-asr-flash-2026-02-10
TTS_MODEL=qwen3-tts-flash-2025-11-27
TTS_VOICE=Jennifer
LLM_MODEL=qwen-plus
OMNI_MODEL=qwen3.8-omni-flash
# 实验性音频诊断（发音观察），默认关闭
ENABLE_AUDIO_DIAGNOSIS=false

# ---- 存储 ----
# local = 本地目录；oss = 阿里云 OSS 私有存储桶
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
# 数据目录（删除日志 deletion-log.jsonl、服务检查记录等）
DATA_DIR=./data
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

# ---- 内容发布 ----
# 生产环境设为 true：只能发布审核状态为 approved 的题目
CONTENT_REQUIRE_REVIEW=false
# 开发 / 模拟试用：种子脚本直接发布 AI 草稿（界面标记"AI 草稿·未人工审核"）
SEED_PUBLISH_DRAFTS=true

# ---- 测试 ----
# 仅自动化测试使用的时间倍率；生产必须为 1
TIME_SCALE=1

# ---- 外部工具 ----
FFMPEG_PATH=ffmpeg
ESPEAK_PATH=espeak-ng

# ---- 部署 ----
# Caddy 使用的域名；本机测试可用 localhost
APP_DOMAIN=localhost
# 本机监听端口，和公网 HTTPS 地址分开配置
PORT=3000
